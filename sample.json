{
  "theme": "auto",
  "tui": "fullscreen",
  "editorMode": "normal",
  "effortLevel": "high",
  "language": "english",
  "preferredNotifChannel": "auto",
  "viewMode": "default",
  "defaultShell": "bash",
  "model": "claude-sonnet-5",
  "fallbackModel": [
    "claude-haiku-4-5-20251001",
    "claude-opus-5"
  ],
  "alwaysThinkingEnabled": false,
  "showThinkingSummaries": true,
  "fastMode": false,
  "autoCompactEnabled": true,
  "autoCompactWindow": 850000,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(npm run test)",
      "Read(./src/**)",
      "WebFetch(https://docs.anthropic.com/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ],
    "additionalDirectories": [
      "../shared-docs"
    ]
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowWrite": [
        "/tmp/build"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.npmjs.org"
      ]
    },
    "excludedCommands": [
      "docker *"
    ]
  },
  "env": {
    "ANTHROPIC_API_KEY": "sk-ant-sample-placeholder-key",
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-4-5-20251001"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Prompt submitted'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(printf '%s' \"$input\" | jq -r '.model.display_name // .model.id'); printf 'Model: %s\\n' \"$model\"",
    "padding": 2
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "worktree",
    "symlinkDirectories": [
      "node_modules",
      ".cache"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "custom-tools": {
      "source": {
        "source": "github",
        "repo": "example-org/claude-plugins"
      }
    }
  },
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 30,
  "autoScrollEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "spinnerTipsEnabled": true
}
